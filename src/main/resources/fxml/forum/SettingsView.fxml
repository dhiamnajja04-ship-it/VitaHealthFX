<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="rootPane" prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.workshopjdbc.Controllers.SettingsController" stylesheets="@../../css/community-feed.css">
    
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 12 25; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 1 0;">
            <Label text="VitaHealth" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>
            <TextField promptText="Search settings..." style="-fx-background-color: #f0f2f5; -fx-background-radius: 25; -fx-padding: 10 20; -fx-font-size: 14px;" prefWidth="400" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15.0" alignment="CENTER">
                <Button text="🔔" style="-fx-background-color: #f0f2f5; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-font-size: 16px;"/>
                <Button text="💬" style="-fx-background-color: #f0f2f5; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-font-size: 16px;"/>
                <HBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-padding: 5 12; -fx-background-radius: 25;">
                    <Circle radius="18.0" style="-fx-fill: linear-gradient(#667eea, #764ba2);"/>
                    <VBox spacing="1.0">
                        <Label text="Dr. Fatma Tounsi" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                        <Label text="Médecin" style="-fx-font-size: 10px; -fx-text-fill: #65676b;"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #ffffff; -fx-border-color: #e4e6eb; -fx-border-width: 0 1 0 0;" spacing="5.0">
            <padding>
                <Insets top="20.0" left="20.0" right="20.0" bottom="20.0"/>
            </padding>
            
            <Label text="MAIN" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
            <Button text="📢 Community Feed" styleClass="nav-button" onAction="#showCommunityFeed"/>
            <Button text="🏥 Patient Care" styleClass="nav-button" onAction="#showPatientCare"/>
            <Button text="📚 Medical Library" styleClass="nav-button" onAction="#showMedicalLibrary"/>
            <Button text="📊 Analytics" styleClass="nav-button" onAction="#showAnalytics"/>
            <Button text="⚙️ Settings" styleClass="nav-button, active-nav" onAction="#showSettings"/>
        </VBox>
    </left>
    
    <!-- Center Content -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 20;">
            <Label text="System Configuration" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
            <Label text="Manage system settings and preferences" style="-fx-font-size: 14px; -fx-text-fill: #65676b;"/>
            
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                <!-- Settings Menu -->
                <VBox prefWidth="280" spacing="8.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);">
                    <Label text="SETTINGS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
                    <Button text="⚙️ General" style="-fx-background-color: #e3f2fd; -fx-text-fill: #1e88e5; -fx-padding: 12 15; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                    <Button text="🔒 Security" style="-fx-background-color: transparent; -fx-text-fill: #65676b; -fx-padding: 12 15; -fx-background-radius: 8;"/>
                    <Button text="🔔 Notifications" style="-fx-background-color: transparent; -fx-text-fill: #65676b; -fx-padding: 12 15; -fx-background-radius: 8;"/>
                    <Button text="👁️ Privacy" style="-fx-background-color: transparent; -fx-text-fill: #65676b; -fx-padding: 12 15; -fx-background-radius: 8;"/>
                    <Button text="🔗 Integrations" style="-fx-background-color: transparent; -fx-text-fill: #65676b; -fx-padding: 12 15; -fx-background-radius: 8;"/>
                    <Separator style="-fx-padding: 10 0;"/>
                    <Button text="📋 Health Records" style="-fx-background-color: transparent; -fx-text-fill: #65676b; -fx-padding: 12 15; -fx-background-radius: 8;"/>
                    <Button text="📊 Preferences" style="-fx-background-color: transparent; -fx-text-fill: #65676b; -fx-padding: 12 15; -fx-background-radius: 8;"/>
                </VBox>
                
                <!-- Content -->
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);">
                        <Label text="General Settings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Separator/>
                        
                        <GridPane vgap="15.0" hgap="15.0">
                            <Label text="Site Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField text="VitaHealth Clinical Sanctuary" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS"/>
                            
                            <Label text="Default Language:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox value="English" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            
                            <Label text="Timezone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <ComboBox value="UTC+1 (Paris)" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            
                            <Label text="Maintenance Mode:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <CheckBox GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                    </VBox>
                    
                    <VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);">
                        <Label text="Security Settings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Separator/>
                        
                        <GridPane vgap="15.0" hgap="15.0">
                            <Label text="Two-Factor Auth:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <CheckBox selected="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            
                            <Label text="Session Timeout:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox value="30 minutes" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            
                            <Label text="Password Policy:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <ComboBox value="Strong (12+ chars)" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>
                    
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button text="Reset Defaults" style="-fx-background-color: #e4e6eb; -fx-text-fill: #050505; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                        <Button text="Save Changes" style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- Right Sidebar -->
    <right>
        <VBox prefWidth="320.0" style="-fx-background-color: #ffffff; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 0 1;" spacing="15.0">
            <padding>
                <Insets top="20.0" left="20.0" right="20.0" bottom="20.0"/>
            </padding>
            
            <VBox spacing="10.0">
                <Label text="SYSTEM INFO" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
                <Label text="Version: 2.1.0" style="-fx-font-size: 13px;"/>
                <Label text="Last update: Today" style="-fx-font-size: 13px;"/>
                <Label text="Build: 2024.05.07" style="-fx-font-size: 13px;"/>
            </VBox>
        </VBox>
    </right>
</BorderPane>
