<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane
    prefHeight="900.0" prefWidth="1400.0"
    style="-fx-background-color: #f0f2f5;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="tn.esprit.workshopjdbc.Controllers.ForumModerationController"
    stylesheets="@../../css/community-feed.css">

    <!-- ═══════════════════════ TOP BAR ═══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0"
              style="-fx-background-color: #ffffff;
                     -fx-padding: 12 25;
                     -fx-border-color: #e4e6eb;
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <Label text="VitaHealth"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>
            <TextField promptText="🔍  Search moderation queue…"
                       styleClass="search-field" prefWidth="380"
                       style="-fx-background-color: #f4f6f8;
                              -fx-background-radius: 20;
                              -fx-border-color: transparent;
                              -fx-padding: 8 16;
                              -fx-font-size: 13px;"
                       HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15.0" alignment="CENTER">
                <Button text="🔔" styleClass="icon-button"
                        style="-fx-background-color: #f4f6f8; -fx-background-radius: 50; -fx-padding: 8;"/>
                <Button text="💬" styleClass="icon-button"
                        style="-fx-background-color: #f4f6f8; -fx-background-radius: 50; -fx-padding: 8;"/>
                <HBox spacing="10.0" alignment="CENTER"
                      style="-fx-background-color: #f8fafc;
                             -fx-padding: 5 14;
                             -fx-background-radius: 25;
                             -fx-border-color: #e4e6eb;
                             -fx-border-radius: 25;">
                    <Circle radius="18.0" style="-fx-fill: linear-gradient(#667eea, #764ba2);"/>
                    <VBox spacing="1.0">
                        <Label text="Dr. Admin"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                        <Label text="Moderator"
                               style="-fx-font-size: 10px; -fx-text-fill: #65676b;"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════════ CENTER ═══════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="0.0">

                <!-- Page Header -->
                <VBox spacing="6.0" style="-fx-padding: 22 25 14 25;">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox spacing="4.0">
                            <Label text="Forum Moderation Dashboard"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                            <Label text="Review reported content, moderate posts, and maintain a healthy community."
                                   style="-fx-text-fill: #65676b; -fx-font-size: 13px;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="refreshBtn" text="🔄  Refresh"
                                style="-fx-background-color: #ffffff;
                                       -fx-text-fill: #374151;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 9 18;
                                       -fx-background-radius: 8;
                                       -fx-border-color: #d1d5db;
                                       -fx-border-radius: 8;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- ─── Stats Row ─── -->
                <HBox spacing="14.0" style="-fx-padding: 18 25 14 25;">

                    <!-- Total Posts -->
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-padding: 16 20;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                 -fx-border-color: #e8f0fe;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📄" style="-fx-font-size: 18px;"/>
                            <Label text="TOTAL POSTS"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #6b7280; -fx-letter-spacing: 0.5px;"/>
                        </HBox>
                        <Label fx:id="totalPostsLabel" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>
                        <Label text="All time"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>

                    <!-- Total Comments -->
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-padding: 16 20;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                 -fx-border-color: #e6f9f0;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="💬" style="-fx-font-size: 18px;"/>
                            <Label text="TOTAL COMMENTS"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #6b7280;"/>
                        </HBox>
                        <Label fx:id="totalCommentsLabel" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                        <Label text="All time"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>

                    <!-- Pending Reviews -->
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-padding: 16 20;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                 -fx-border-color: #fef3e2;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⏳" style="-fx-font-size: 18px;"/>
                            <Label text="PENDING REVIEWS"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #6b7280;"/>
                        </HBox>
                        <Label fx:id="pendingReviewsLabel" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                        <Label text="Needs action"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>

                    <!-- Reported Posts -->
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-padding: 16 20;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                 -fx-border-color: #fde8e8;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🚨" style="-fx-font-size: 18px;"/>
                            <Label text="REPORTED POSTS"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #6b7280;"/>
                        </HBox>
                        <Label fx:id="reportedPostsLabel" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                        <Label text="Flagged content"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>

                </HBox>

                <!-- ─── Charts Row ─── -->
                <HBox spacing="14.0" style="-fx-padding: 0 25 18 25;">
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-padding: 20;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="Post Status Distribution"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <javafx.scene.chart.PieChart fx:id="statusPieChart"
                                                     prefHeight="240.0" legendVisible="true"/>
                    </VBox>
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-padding: 20;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="Posts &amp; Comments Activity"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <javafx.scene.chart.BarChart fx:id="activityBarChart"
                                                     prefHeight="240.0" legendVisible="true">
                            <xAxis><javafx.scene.chart.CategoryAxis side="BOTTOM"/></xAxis>
                            <yAxis><javafx.scene.chart.NumberAxis side="LEFT"/></yAxis>
                        </javafx.scene.chart.BarChart>
                    </VBox>
                </HBox>

                <!-- ═══════════════ MAIN CONTENT (Table + Sidebar) ═══════════════ -->
                <HBox spacing="18.0" style="-fx-padding: 0 25 28 25;" VBox.vgrow="ALWAYS">

                    <!-- ───────────── LEFT: Enhanced Table Panel ───────────── -->
                    <VBox spacing="0.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2);">

                        <!-- Table Panel Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                              style="-fx-padding: 16 20 14 20;
                                     -fx-border-color: transparent transparent #f3f4f6 transparent;
                                     -fx-border-width: 1;">
                            <VBox spacing="2.0">
                                <Label text="All Posts"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                <Label fx:id="messageLabel" text="Loading posts…"
                                       style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- Quick filter pills -->
                            <HBox spacing="6.0" alignment="CENTER">
                                <Button text="All"
                                        style="-fx-background-color: #1e88e5;
                                               -fx-text-fill: white;
                                               -fx-font-size: 11px;
                                               -fx-font-weight: bold;
                                               -fx-padding: 5 12;
                                               -fx-background-radius: 20;
                                               -fx-cursor: hand;"/>
                                <Button text="Pending"
                                        style="-fx-background-color: #fff3cd;
                                               -fx-text-fill: #856404;
                                               -fx-font-size: 11px;
                                               -fx-font-weight: bold;
                                               -fx-padding: 5 12;
                                               -fx-background-radius: 20;
                                               -fx-cursor: hand;"/>
                                <Button text="Reported"
                                        style="-fx-background-color: #fee2e2;
                                               -fx-text-fill: #dc2626;
                                               -fx-font-size: 11px;
                                               -fx-font-weight: bold;
                                               -fx-padding: 5 12;
                                               -fx-background-radius: 20;
                                               -fx-cursor: hand;"/>
                            </HBox>

                            <ComboBox fx:id="filterCombo" promptText="Filter by status"
                                      prefWidth="150"
                                      style="-fx-padding: 6 10;
                                             -fx-background-radius: 8;
                                             -fx-border-color: #d1d5db;
                                             -fx-border-radius: 8;
                                             -fx-background-color: #f9fafb;
                                             -fx-font-size: 12px;"/>
                        </HBox>

                        <!-- ── TableView ── -->
                        <TableView fx:id="moderationTable"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-table-cell-border-color: #f3f4f6;
                                          -fx-padding: 0;">
                            <columns>

                                <!-- Title -->
                                <TableColumn fx:id="colTitle" text="TITLE" prefWidth="230"
                                             style="-fx-alignment: CENTER-LEFT;"/>

                                <!-- Category -->
                                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="110"
                                             style="-fx-alignment: CENTER;"/>

                                <!-- Author -->
                                <TableColumn fx:id="colAuthor" text="AUTHOR" prefWidth="130"
                                             style="-fx-alignment: CENTER-LEFT;"/>

                                <!-- Status — rendered as a pill badge in controller -->
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="105"
                                             style="-fx-alignment: CENTER;"/>

                                <!-- Comments -->
                                <TableColumn fx:id="colComments" text="💬" prefWidth="60"
                                             style="-fx-alignment: CENTER;"/>

                                <!-- Reports -->
                                <TableColumn fx:id="colReports" text="🚨" prefWidth="60"
                                             style="-fx-alignment: CENTER;"/>

                                <!-- Date -->
                                <TableColumn fx:id="colDate" text="DATE" prefWidth="115"
                                             style="-fx-alignment: CENTER;"/>

                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="10.0"
                                      style="-fx-padding: 50;">
                                    <Label text="📭"
                                           style="-fx-font-size: 40px;"/>
                                    <Label text="No posts found"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                    <Label text="Try adjusting the filter or refreshing the queue."
                                           style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                                </VBox>
                            </placeholder>
                        </TableView>

                        <!-- Table Footer -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                              style="-fx-padding: 10 20;
                                     -fx-background-color: #f9fafb;
                                     -fx-border-color: #f3f4f6 transparent transparent transparent;
                                     -fx-border-width: 1;
                                     -fx-background-radius: 0 0 14 14;">
                            <Label text="Showing all results"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="← Prev"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: #d1d5db;
                                           -fx-border-radius: 6;
                                           -fx-padding: 4 12;
                                           -fx-font-size: 11px;
                                           -fx-cursor: hand;"/>
                            <Button text="Next →"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: #d1d5db;
                                           -fx-border-radius: 6;
                                           -fx-padding: 4 12;
                                           -fx-font-size: 11px;
                                           -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- ───────────── RIGHT: Review Details Sidebar ───────────── -->
                    <VBox spacing="14.0" prefWidth="390.0">

                        <Label text="Review Details"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                        <!-- Details Card -->
                        <VBox spacing="14.0" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #ffffff;
                                     -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2);">

                            <Label fx:id="metaLabel" text="Select a post to review"
                                   wrapText="true"
                                   style="-fx-text-fill: #65676b; -fx-font-size: 12px;"/>
                            <Separator/>
                            <Label text="CONTENT"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #9ca3af; -fx-letter-spacing: 1px;"/>
                            <TextArea fx:id="contentArea" editable="false" wrapText="true"
                                      prefHeight="170.0"
                                      style="-fx-font-size: 12px;
                                             -fx-padding: 10;
                                             -fx-background-radius: 8;
                                             -fx-background-color: #f8fafc;
                                             -fx-border-color: #e5e7eb;
                                             -fx-border-radius: 8;
                                             -fx-text-fill: #374151;"/>
                            <Separator/>
                            <Label text="VIOLATION REASONS"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #9ca3af; -fx-letter-spacing: 1px;"/>
                            <VBox spacing="8.0"
                                  style="-fx-background-color: #f9fafb;
                                         -fx-padding: 12;
                                         -fx-background-radius: 8;
                                         -fx-border-color: #e5e7eb;
                                         -fx-border-radius: 8;">
                                <CheckBox text="Abusive Language"
                                          style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                                <CheckBox text="Spam / Advertising"
                                          style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                                <CheckBox text="Medical Misinformation"
                                          style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                                <CheckBox text="Harassment"
                                          style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </VBox>
                        </VBox>

                        <!-- Action Buttons -->
                        <VBox spacing="7.0">
                            <Button fx:id="editBtn" text="✏️   Edit Post"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #3b82f6;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-padding: 11 20;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 13px;
                                           -fx-cursor: hand;">
                                <VBox.margin><Insets top="4.0"/></VBox.margin>
                            </Button>
                            <Button fx:id="publishBtn" text="✅   Approve / Publish"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #16a34a;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-padding: 11 20;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 13px;
                                           -fx-cursor: hand;"/>
                            <Button fx:id="hideBtn" text="👁   Hide Post"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #fef9c3;
                                           -fx-text-fill: #854d0e;
                                           -fx-font-weight: bold;
                                           -fx-padding: 11 20;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 13px;
                                           -fx-cursor: hand;
                                           -fx-border-color: #fde68a;
                                           -fx-border-radius: 9;"/>
                            <Button fx:id="lockBtn" text="🔒   Lock Thread"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #f3f4f6;
                                           -fx-text-fill: #374151;
                                           -fx-font-weight: bold;
                                           -fx-padding: 11 20;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 13px;
                                           -fx-cursor: hand;
                                           -fx-border-color: #e5e7eb;
                                           -fx-border-radius: 9;"/>
                            <Button fx:id="deleteBtn" text="🗑   Delete Post"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #fef2f2;
                                           -fx-text-fill: #dc2626;
                                           -fx-font-weight: bold;
                                           -fx-padding: 11 20;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 13px;
                                           -fx-cursor: hand;
                                           -fx-border-color: #fecaca;
                                           -fx-border-radius: 9;"/>
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
