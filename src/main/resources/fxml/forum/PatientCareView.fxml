<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.workshopjdbc.Controllers.PatientCareController" stylesheets="@../../css/community-feed.css">
    
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 12 25; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 1 0;">
            <Label text="VitaHealth" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>
            <TextField promptText="Search patients..." styleClass="search-field" prefWidth="400" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15.0" alignment="CENTER">
                <Button text="🔔" styleClass="icon-button"/>
                <Button text="💬" styleClass="icon-button"/>
                <HBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-padding: 5 12; -fx-background-radius: 25;">
                    <Circle radius="18.0" style="-fx-fill: linear-gradient(#667eea, #764ba2);"/>
                    <VBox spacing="1.0">
                        <Label text="Dr. Fatma Tounsi" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                        <Label text="Médecin" style="-fx-font-size: 10px; -fx-text-fill: #65676b;"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #ffffff; -fx-border-color: #e4e6eb; -fx-border-width: 0 1 0 0;" spacing="5.0">
            <padding>
                <Insets top="20.0" left="20.0" right="20.0" bottom="20.0"/>
            </padding>
            <Label text="MAIN" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
            <Button text="📢 Community Feed" styleClass="nav-button" onAction="#showCommunityFeed"/>
            <Button text="🏥 Patient Care" styleClass="nav-button, active-nav" onAction="#showPatientCare"/>
            <Button text="📚 Medical Library" styleClass="nav-button" onAction="#showMedicalLibrary"/>
            <Button text="📊 Analytics" styleClass="nav-button" onAction="#showAnalytics"/>
            <Button text="⚙️ Settings" styleClass="nav-button" onAction="#showSettings"/>
            <Separator style="-fx-padding: 15 0;"/>
            <Label text="QUICK ACTIONS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
            <Button text="+ New Patient" styleClass="primary-action-button"/>
            <Button text="📋 View Appointments" styleClass="nav-button"/>
            <Button text="📈 View Reports" styleClass="nav-button"/>
        </VBox>
    </left>
    
    <!-- Center Content -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 20;">
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="Patient Care Center" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField promptText="Search patients..." style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 10 15;" prefWidth="250"/>
            </HBox>
            
            <HBox spacing="15.0">
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL PATIENTS" style="-fx-font-size: 11px; -fx-text-fill: #90949c;"/>
                    <Label text="1,247" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <Label text="ACTIVE CASES" style="-fx-font-size: 11px; -fx-text-fill: #90949c;"/>
                    <Label text="342" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <Label text="CRITICAL" style="-fx-font-size: 11px; -fx-text-fill: #90949c;"/>
                    <Label text="18" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <Label text="RECOVERED" style="-fx-font-size: 11px; -fx-text-fill: #90949c;"/>
                    <Label text="887" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>
            </HBox>
            
            <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Recent Patients" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Filter" style="-fx-background-color: #e4e6eb; -fx-text-fill: #050505; -fx-padding: 8 16; -fx-background-radius: 8;"/>
                    <Button text="Export" style="-fx-background-color: #e4e6eb; -fx-text-fill: #050505; -fx-padding: 8 16; -fx-background-radius: 8;"/>
                </HBox>
                <TableView fx:id="patientsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPatientName" text="Patient Name" prefWidth="200"/>
                        <TableColumn fx:id="colCondition" text="Condition" prefWidth="150"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colLastVisit" text="Last Visit" prefWidth="150"/>
                        <TableColumn fx:id="colDoctor" text="Assigned Doctor" prefWidth="150"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    
    <!-- Right Sidebar modernisée -->
    <right>
        <VBox prefWidth="320.0" style="-fx-background-color: #ffffff; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 0 1;" spacing="15.0">
            <padding>
                <Insets top="20.0" left="20.0" right="20.0" bottom="20.0"/>
            </padding>
            <VBox spacing="10.0" style="-fx-background-color: #fff8e1; -fx-padding: 15; -fx-background-radius: 12;">
                <Label text="⚠️ Critical Alerts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                <Label text="3 patients require immediate attention" style="-fx-font-size: 12px; -fx-text-fill: #65676b;"/>
            </VBox>
            <VBox spacing="10.0">
                <Label text="TODAY'S APPOINTMENTS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
                <VBox spacing="8.0">
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Circle radius="20.0" style="-fx-fill: #e3f2fd;"/>
                        <VBox>
                            <Label text="Ahmed Ben Salah" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label text="10:30 AM - Checkup" style="-fx-font-size: 11px; -fx-text-fill: #65676b;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Circle radius="20.0" style="-fx-fill: #e8f5e9;"/>
                        <VBox>
                            <Label text="Fatima Zohra" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label text="11:45 AM - Follow-up" style="-fx-font-size: 11px; -fx-text-fill: #65676b;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </right>
</BorderPane>
