<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.workshopjdbc.Controllers.MedicalLibraryController" stylesheets="@../../css/community-feed.css">
    
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 12 25; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 1 0;">
            <Label text="VitaHealth" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>
            <TextField promptText="Search resources..." style="-fx-background-color: #f0f2f5; -fx-background-radius: 25; -fx-padding: 10 20; -fx-font-size: 14px;" prefWidth="400" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15.0" alignment="CENTER">
                <Button text="🔔" style="-fx-background-color: #f0f2f5; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-font-size: 16px;"/>
                <Button text="💬" style="-fx-background-color: #f0f2f5; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-font-size: 16px;"/>
                <HBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-padding: 5 12; -fx-background-radius: 25;">
                    <Circle radius="18.0" style="-fx-fill: linear-gradient(#667eea, #764ba2);"/>
                    <VBox spacing="1.0">
                        <Label text="Dr. Fatma Tounsi" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                        <Label text="Médecin" style="-fx-font-size: 10px; -fx-text-fill: #65676b;"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #ffffff; -fx-border-color: #e4e6eb; -fx-border-width: 0 1 0 0;" spacing="5.0">
            <padding>
                <Insets top="20.0" left="20.0" right="20.0" bottom="20.0"/>
            </padding>
            
            <Label text="MAIN" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
            <Button text="📢 Community Feed" styleClass="nav-button" onAction="#showCommunityFeed"/>
            <Button text="🏥 Patient Care" styleClass="nav-button" onAction="#showPatientCare"/>
            <Button text="📚 Medical Library" styleClass="nav-button, active-nav" onAction="#showMedicalLibrary"/>
            <Button text="📊 Analytics" styleClass="nav-button" onAction="#showAnalytics"/>
            <Button text="⚙️ Settings" styleClass="nav-button" onAction="#showSettings"/>
            
            <Separator style="-fx-padding: 15 0;"/>
            
            <Label text="CATEGORIES" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
            <Button text="📄 Clinical Guidelines" styleClass="nav-button"/>
            <Button text="🔬 Research Papers" styleClass="nav-button"/>
            <Button text="📋 Case Studies" styleClass="nav-button"/>
            <Button text="🎓 Training Materials" styleClass="nav-button"/>
        </VBox>
    </left>
    
    <!-- Center Content -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 20;">
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="Medical Library" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #050505;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField promptText="Search resources..." style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 10 15;" prefWidth="250"/>
                <Button text="+ Add Resource" style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
            </HBox>
            
            <HBox spacing="10.0">
                <Button text="📋 All Resources" style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button text="📄 Clinical Guidelines" style="-fx-background-color: #e3f2fd; -fx-text-fill: #1e88e5; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button text="🔬 Research Papers" style="-fx-background-color: #f3e5f5; -fx-text-fill: #7b1fa2; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button text="📖 Case Studies" style="-fx-background-color: #e8f5e9; -fx-text-fill: #2e7d32; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button text="🎓 Training Materials" style="-fx-background-color: #fff3e0; -fx-text-fill: #e65100; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
            </HBox>
            
            <VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);" VBox.vgrow="ALWAYS">
                <Label text="Recent Resources" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                
                <TableView fx:id="resourcesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitle" text="Title" prefWidth="300"/>
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                        <TableColumn fx:id="colAuthor" text="Author" prefWidth="150"/>
                        <TableColumn fx:id="colDate" text="Date Added" prefWidth="120"/>
                        <TableColumn fx:id="colDownloads" text="Downloads" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    
    <!-- Right Sidebar -->
    <right>
        <VBox prefWidth="320.0" style="-fx-background-color: #ffffff; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 0 1;" spacing="15.0">
            <padding>
                <Insets top="20.0" left="20.0" right="20.0" bottom="20.0"/>
            </padding>
            
            <VBox spacing="10.0">
                <Label text="POPULAR RESOURCES" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #90949c;"/>
                <VBox spacing="8.0">
                    <Label text="Hypertension Guidelines 2024" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label text="1,247 downloads" style="-fx-font-size: 11px; -fx-text-fill: #65676b;"/>
                </VBox>
                <VBox spacing="8.0">
                    <Label text="COVID-19 Long-term Effects" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label text="892 downloads" style="-fx-font-size: 11px; -fx-text-fill: #65676b;"/>
                </VBox>
            </VBox>
        </VBox>
    </right>
</BorderPane>
